{
  "required": false, // We don't want to force the player into support so it is completely optional
  "package": "com.jkdr.abyssalascentdimensionpatcher.mixins.compat",
  "refmap": "mixins.abyssalascentdimensionpatcher.refmap.json",
  "plugin": "com.jkdr.abyssalascentdimensionpatcher.mixins.compat.DisableImmPtlIrisMixinsPlugin",
  "priority": 2000, // Important: Use high priority here to ensure our mixins get applied and not immersive portals just in case
  "compatibilityLevel": "JAVA_17",
  "mixins": [
    // C2ME compatility
    // takes these methods off of the server thread onto the chunk loading thread
    "c2meSupport.spartanWeaponry.MixinItemRandomizer",
    "c2meSupport.aether_redux.MixinBlightwillowRootsPlacer"

  ],
  "server": [ "patch.blockbreaking.MixinServerPlayerGameModePatchForDedicatedServers" ],

  "client": [
    // Oculus 1.8.0 / Iris compatibility
    // Replaces old imports with the prefix "coderbot" with the new ones "irisshaders"
    "oculus180Support.imm_ptl.MixinExperimentalIrisPortalRenderer",
    "oculus180Support.imm_ptl.MixinOnIrisPresent",
    "oculus180Support.imm_ptl.MixinPortalRenderer",
    "oculus180Support.imm_ptl.MixinIExpIrisPortalRenderer",

    "oculus180Support.imm_ptl.replace.MixinIrisClearPass",
    "oculus180Support.imm_ptl.replace.MixinIrisFinalPassRenderer",
    "oculus180Support.imm_ptl.replace.MixinIrisRenderingPipeline",
    "oculus180Support.imm_ptl.replace.MixinIrisShadowRenderTargets",
    "oculus180Support.imm_ptl.replace.MixinIrisSodiumChunkShaderInterface",
    "oculus180Support.imm_ptl.replace.MixinIrisSodiumSodiumTerrainPipeline",

    // Distant Horizons compatibility
    // Fixes issues with Distant Horizons not working properly with Immersive Portals on dedicated servers
    "distantHorizons.imm_ptl.MixinClientTeleportationManager",
    "distantHorizons.MixinKeyedClientLevelManager",
    "distantHorizons.IMixinClientLevelWrapper",
    "distantHorizons.IMixinClientApi",
    "distantHorizons.IMixinClientPluginChannelApi",
    "distantHorizons.MixinFullDataPayloadReceiver",
    "distantHorizons.MixinClientApi"


  ],
  "injectors": {
    "defaultRequire": 0
  }
}